{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "regions": ["lhr1"],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300" }]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/public/**,index.html}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fidonect-taiwokudehinbu.vercel.app" }],
      "destination": "https://fidonect.vercel.app/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fidonect-git-main-taiwokudehinbu.vercel.app" }],
      "destination": "https://fidonect.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fidonect-taiwokudehinbu.vercel.app" }],
      "destination": "https://fidonect.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fidonect-git-main-taiwokudehinbu.vercel.app" }],
      "destination": "https://fidonect.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
